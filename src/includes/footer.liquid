<footer class='footer-social'>
  <div class='container container-flex-center'>
    <ul class='footer'>
      {% for link in footer.links %}
        <li class='footer-item'>
          <a
            class='footer-link {{ link.class }}'
            href='{{ link.href }}'
            {% if link.ariaLabel %}
            aria-label='{{ link.ariaLabel }}'
            {% endif %}
          >
            <i class='fab fa-{{ link.class }}'></i>
            <span class='icon-text'>{{ link.text }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</footer>
