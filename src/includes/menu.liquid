<div class='sidebar'>
    <div class='navbar-collapse' id='navbar-collapse'>
        <ul class='navbar-nav'>
            <li class='nav-item desktop'>
                <!-- <button class="button-link order" data-toggle="modal" data-target="#contact-with-modal"> -->
                <!-- Заказать домик -->
                <!-- </button> -->

                <div class='phones'>
                    {% for phone in sidebar.phones %}
                        <a
                            class='phone'
                            href='{{ phone.href }}'
                        >
                            <span>{{ phone.text }}</span>
                        </a>
                    {% endfor %}
                </div>
            </li>

            {% for menu in sidebar.menus %}
                <li class='nav-item'>
                    <a class='nav-link' href='{{ menu.href }}'>{{ menu.text }}</a>
                </li>
            {% endfor %}

            <li class='nav-item mobile'>
                <!-- <button class="button-link order" data-toggle="modal" data-target="#contact-with-modal"> -->
                <!-- Заказать баню -->
                <!-- </button> -->

                <div>
                    {{ sidebar.button.text }}
                </div>
                <div class='phones'>
                    {% for phone in sidebar.phones %}
                        <p>
                            <a
                                class='button-link phone'
                                href='{{ phone.href }}'
                            >
                                {{ phone.text }}
                            </a>
                        </p>
                    {% endfor %}
                </div>
            </li>

            <li class='nav-item mobile'>
                <a class='nav-link' href='#map'>
                    {{ sidebar.howTo }}
                </a>
            </li>

            <!-- <% render 'components/contact-button.ejs' %> -->
        </ul>
        <nav class='nav-footer'>
            <div>{{ sidebar.author.co }}</div>
            <div>{{ sidebar.author.by }}</div>
        </nav>
    </div>
</div>
