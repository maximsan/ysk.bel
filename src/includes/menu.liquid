<div class='menu'>
    <div class='navbar-collapse' id='navbar-collapse'>
        <ul class='navbar-nav'>
            {% comment %} <li class='nav-item desktop'> {% endcomment %}
            <!-- <button class="button-link order" data-toggle="modal" data-target="#contact-with-modal"> -->
            <!-- Заказать домик -->
            <!-- </button> -->
            {% comment %} </li> {% endcomment %}

            {% for menu in sidebar.menus %}
                <li class='nav-item'>
                    {% if menu.type == 'link' %}
                        <a class='nav-link' href='{{ menu.href }}'>
                            {{ menu.text }}
                        </a>
                    {% else %}
                        <a class='nav-link phone' href='{{ menu.href }}'>
                            <span>{{ menu.text }}</span>
                        </a>
                    {% endif %}
                </li>
            {% endfor %}

            <li class='nav-item mobile'>
                <!-- <button class="button-link order" data-toggle="modal" data-target="#contact-with-modal"> -->
                <!-- Заказать баню -->
                <!-- </button> -->

                <div>
                    {{ sidebar.button.text }}
                </div>
                <div class='phones'>
                    {% for phone in sidebar.phones %}
                        <p>
                            <a
                                class='button-link phone'
                                href='{{ phone.href }}'
                            >
                                {{ phone.text }}
                            </a>
                        </p>
                    {% endfor %}
                </div>
            </li>

            <li class='nav-item mobile'>
                <a class='nav-link' href='#map'>
                    {{ sidebar.howTo }}
                </a>
            </li>

            <!-- <% render 'components/contact-button.ejs' %> -->
        </ul>

        {% render 'components/mobile-menu-footer' %}
    </div>
</div>
