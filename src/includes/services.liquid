<section class="section-container services py-10rem" id="desc">
    <div class="container">
        <div class="content bg-creamy-white">
            <div class="row">
                <div class="col-12">
                    <div class="content-header">
                        <h2>
                            {{ services.header }}
                        </h2>
                    </div>
                    <p class="content-text">
                        {{ services.description }}
                    </p>
                </div>

                {% render 'packages' %}

                {%  for section in services.sections %}

                    <div class="col-12">
                        <h3
                                class="content-cell-header {{ section.class }} text-center w-100 mb-3rem mt-1rem"
                                id="{{ section.id }}"
                        >
                            {{ section.header }}
                        </h3>
                    </div>

                        <div class="content-cell {{ section.class }} service col-12 col-md-12 ml-1rem pr-2rem mb-5rem">
                            <div class="row">

                                {% assign main = section.gallery.main %}
                                {% assign galleryItems = section.gallery.items %}

                                {% if section.side == 'left' %}

                                <div class="content-cell-element img col-12 col-sm-12 col-md-8 gallery">

                                        <div class="gallery__desk--{{ section.side }}-side {% if section.isFirst %} first {% endif %}">
                                            {% for item in galleryItems  %}
                                                        <a
                                                            href="{{ item.link.src }}"
                                                            data-pswp-width="{{ item.link.width }}"
                                                            data-pswp-height="{{ item.link.height }}"
                                                            target="{{ item.link.target }}"
                                                            data-cropped="{{ item.link.isCropped }}"
                                                            class="gallery__url"
                                                        >
                                                            <img src="{{ item.img.srcSet[0] }}"
                                                                alt="{{ item.img.alt }}"
                                                                class="gallery__img card-img-top">
                                                            <figure class="gallery__figure">{{ item.img.caption }}</figure>
                                                        </a>
                                            {% endfor %}
                                        </div>

                                        <div class="gallery__item--main">
                                            <a  href="{{ main.link.src }}"
                                                data-pswp-width="{{ main.link.width }}"
                                                data-pswp-height="{{ main.link.height }}"
                                                class="gallery__url">
                                                <img
                                                    srcset="{{ main.img.srcSet | join: ', ' }}"
                                                    sizes="{{  main.img.sizes | join: ', ' }}"
                                                    alt="{{ main.img.alt }}"
                                                    class="gallery__img card-img-top">
                                                <figure class="gallery__figure">{{ main.img.caption }}</figure>
                                            </a>

                                        </div>


                                </div>

                                <div class="content-cell-element text col-12 col-sm-12 col-md-4">
                                    <div class="content-cell-text">
                                        <div class="content-cell-rubric">
                                            <p>
                                            <ul class="fish-list">

                                            {% for item in section.offer.items %}
                                                <li>
                                                    <span class="fish-name">{{ item }}</span>
                                                </li>
                                            {% endfor %}
                                            </ul>
                                            </p>
                                            {{ section.offer.description }}
                                        </div>
                                    </div>
                                </div>

                                {% else  %}

                                <div class="content-cell-element text col-12 col-sm-12 col-md-4">
                                    <div class="content-cell-text">
                                        <div class="content-cell-rubric">
                                            <p>
                                            <ul class="fish-list">

                                            {% for item in section.offer.items %}
                                                <li>
                                                    <span class="fish-name">{{ item }}</span>
                                                </li>
                                            {% endfor %}
                                            </ul>
                                            </p>
                                            {{ section.offer.description }}
                                        </div>
                                    </div>
                                </div>
                                <div class="content-cell-element img col-12 col-sm-12 col-md-8 gallery">

                                    <div class="gallery__item--main">
                                        <a  href="{{ main.link.src }}"
                                            data-pswp-width="{{ main.link.width }}"
                                            data-pswp-height="{{ main.link.height }}"
                                            class="gallery__url">
                                            <img
                                                srcset="{{ main.img.srcSet | join: ', ' }}"
                                                sizes="{{  main.img.sizes | join: ', ' }}"
                                                alt="{{ main.img.alt }}"
                                                class="gallery__img card-img-top">
                                            <figure class="gallery__figure">{{ main.img.caption }}</figure>
                                        </a>

                                    </div>

                                    <div class="gallery__desk--{{ section.side }}-side {% if section.isFirst %} first {% endif %}">
                                        {% for item in galleryItems  %}
                                                    <a
                                                        href="{{ item.link.src }}"
                                                        data-pswp-width="{{ item.link.width }}"
                                                        data-pswp-height="{{ item.link.height }}"
                                                        target="{{ item.link.target }}"
                                                        data-cropped="{{ item.link.isCropped }}"
                                                        class="gallery__url"
                                                    >
                                                        <img src="{{ item.img.srcSet[0] }}"
                                                            alt="{{ item.img.alt }}"
                                                            class="gallery__img card-img-top">
                                                        <figure class="gallery__figure">{{ item.img.caption }}</figure>
                                                    </a>
                                        {% endfor %}
                                    </div>

                                </div>

                                {% endif %}
                            </div>
                        </div>

                {% endfor %}

            </div>
        </div>
    </div>
</section>
