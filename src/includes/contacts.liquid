<section class='section-container contacts section-chapter' id='contacts'>
  <div class='container'>
    <div class='row'>
      <div class='col-12 col-lg-6'>
        <div class='our-contacts'>
          <div class='address'>
            <h4 class='address-header'>{{ contacts.header }}</h4>
            <div class='address-desc'>
              <div class='address-desc-item'>
                {{ contacts.region }}
              </div>
              <div class='address-desc-item'>
                {{ contacts.address }}
              </div>
              <div class='address-desc-item'>
                {{ contacts.companyName }}
              </div>
              <div class='address-desc-item'>
                {{ contacts.coordinates.header }}
              </div>
              <div class='address-desc-item'>
                {{ contacts.coordinates.lat }}
              </div>
              <div class='address-desc-item'>
                {{ contacts.coordinates.lng }}
              </div>
            </div>
          </div>
          <div class='address'>
            <h4 class='address-header'>{{ contacts.contactUs.header }}</h4>
            <div class='address-desc'>
              <div class='contact-us'>
                {% for phone in contacts.contactUs.phones %}
                  <div class='contact-us__{{ phone.operator }}'>
                    <img
                      alt=''
                      class='{{ phone.operator }}-icon'
                      src='{{ phone.iconUrl }}'
                      width='24'
                      height='24'
                      decoding='async'
                    >
                    <a
                      href='{{ phone.href }}'
                      class='phone-number'
                      {% if phone.ariaLabel %}
                        aria-label='{{ phone.ariaLabel }}'
                      {% endif %}
                    >
                      {{- phone.text -}}
                    </a>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class='col-12 col-lg-6'>
        <div
          class='map-shell map-shell--loading'
          id='map'
        >
          <div
            class='map-shell__skeleton media-skeleton'
            aria-hidden='true'
            data-map-skeleton
          ></div>
          <div
            class='map'
            id='map-canvas'
            role='application'
            aria-label='Карта: расположение усадьбы'
          ></div>
          <div
            class='map-shell__fallback'
            id='map-fallback'
            role='status'
            hidden
          >
            <p class='map-shell__fallback-text'>
              Карта временно недоступна.
            </p>
            <a
              class='map-shell__fallback-link'
              href='https://www.google.com/maps/dir/?api=1&destination=54.291652%2C27.480454'
              target='_blank'
              rel='noopener noreferrer'
            >
              Открыть маршрут в Google Maps
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
