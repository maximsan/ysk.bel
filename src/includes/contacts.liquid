<section class="section-container contacts" id="contacts">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-12 col-lg-6">
                        <div class="our-contacts">
                            <div class="address">
                                <h4>{{ contacts.header }}</h4>
                                <div class="address-desc">
                                    <div class="address-desc-item">
                                        {{ contacts.region }}
                                    </div>
                                    <div class="address-desc-item">
                                        {{ contacts.address }}
                                    </div>
                                    <div class="address-desc-item">
                                        {{ contacts.companyName }}
                                    </div>
                                    <div class="address-desc-item">
                                        {{ contacts.coordinates.header }}
                                    </div>
                                    <div class="address-desc-item">
                                        {{ contacts.coordinates.lat }}
                                    </div>
                                    <div class="address-desc-item">
                                        {{ contacts.coordinates.lng }}
                                    </div>
                                </div>
                            </div>
                            <div class="address">
                                <h4>{{ contacts.contacts.header }}</h4>
                                <div class="address-desc contact-us">
                                    <div class="contact-us-mail">
                                        <img
                                            alt="почта"
                                            class="mail-icon"
                                            src="assets/images/icons/mail.svg"
                                        />
                                        <a
                                            class=""
                                            href="mailto:oleg-magnat@tut.by"
                                        >{{ contacts.contacts.email }}</a
                                        >
                                    </div>
                                    <div class="contact-us-phones">
                                        <div class="contact-us-phones-header">
                                            {{ contacts.contacts.phones.header }}
                                        </div>
                                        <div class="contact-us-phones-mts">
                                            <img
                                                alt="mts"
                                                class="mts-icon"
                                                src="assets/images/icons/mts.svg"
                                            />
                                            <span href="{{ contacts.contacts.phones.href1 }}" class="phone-number"
                                            >{{ contacts.contacts.phones.phone1 }}</span
                                            >
                                        </div>
                                        <div class="contact-us-phones-velcom">
                                            <img
                                                alt="velcom"
                                                class="velcom-icon"
                                                src="assets/images/icons/a1.svg"
                                                style="-webkit-user-select: none;"
                                            />
                                            <span href="{{ contacts.contacts.phones.href2 }}" class="phone-number"
                                            >{{ contacts.contacts.phones.phone2 }}</span
                                            >
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-12 col-md-12 col-lg-6">
                        <div class="map" id="map"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
