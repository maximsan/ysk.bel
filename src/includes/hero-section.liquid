{%- comment -%}
  Home hero: first-screen photo, headline, CTA row, and trust chips.

  The optimized responsive photo is a decorative CSS background with an
  explicit preload so the browser can discover the LCP image early.
  `_hero.scss` owns the layout and readable scrim (docs/glossary.md «Scrim»);
  this partial keeps the semantic markup.

  Data:
    - `meta.heroEyebrow`       — optional line above the heading
    - `meta.brandStory`        — lede below the heading
    - `meta.heroCta.primary`   — dominant action, usually `tel:`
    - `meta.heroCta.secondary` — ghost action, usually `#services`
    - `meta.heroTrustStrip`    — three short benefit chips
{%- endcomment -%}
<section
  class='section-container hero intro'
  aria-labelledby='hero-title'
>
  <div class='hero__scrim' aria-hidden='true'></div>

  <div class='container hero-content'>
    <div class='hero-header'>
      {% if meta.heroEyebrow %}
        <p class='hero__eyebrow'>
          <span class='hero__eyebrow-rule' aria-hidden='true'></span>
          <span class='hero__eyebrow-text'>{{ meta.heroEyebrow }}</span>
          <span class='hero__eyebrow-rule' aria-hidden='true'></span>
        </p>
      {% endif %}

      <h1 id='hero-title' class='hero__title'>
        <span class='hero__title-line'>Мечтали порыбачить и отдохнуть?</span>
        <span class='hero__title-line hero__title-line--accent'> Усадьба Серебряный Карась ждёт Вас </span>
      </h1>

      <p class='hero__story'>{{ meta.brandStory }}</p>

      {% if meta.heroCta.primary or meta.heroCta.secondary %}
        <div
          class='hero__cta cta-row'
          role='group'
          aria-label='Забронировать или посмотреть услуги'
        >
          {% if meta.heroCta.primary %}
            <a
              class='cta cta--primary hero__cta-primary'
              href='{{ meta.heroCta.primary.href }}'
              {% if meta.heroCta.primary.ariaLabel %}
                aria-label='{{ meta.heroCta.primary.ariaLabel }}'
              {% endif %}
            >
              {{- meta.heroCta.primary.label -}}
            </a>
          {% endif %}
          {% if meta.heroCta.secondary %}
            <a
              class='cta cta--ghost hero__cta-secondary'
              href='{{ meta.heroCta.secondary.href }}'
              {% if meta.heroCta.secondary.ariaLabel %}
                aria-label='{{ meta.heroCta.secondary.ariaLabel }}'
              {% endif %}
            >
              {{- meta.heroCta.secondary.label -}}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if meta.heroTrustStrip.size > 0 %}
        <ul class='hero__trust' role='list'>
          {% for item in meta.heroTrustStrip %}
            <li class='hero__trust-item'>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>
