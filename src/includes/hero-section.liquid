{%- comment -%}
  Hero — первый экран на главной.

  Group B редизайна (см. `docs/hero-info-cooperation-redesign-plan.md`):
    - Оптимизированная hero-фотография через CSS background + preload
      (так Lighthouse не откладывает LCP на декоративном изображении).
    - Один <h1>, eyebrow-строка с копперной линейкой, CTA-ряд по единому
      словарю `_cta.scss`, trust strip.
    - Сетка и scrim полностью описаны в `_hero.scss` — здесь только разметка.

  Данные:
    - `meta.heroEyebrow`      — опциональная строка над заголовком
    - `meta.brandStory`       — lede под заголовком
    - `meta.heroCta.primary`  — доминантная кнопка (обычно tel:)
    - `meta.heroCta.secondary`— ghost-кнопка (обычно #services)
    - `meta.heroTrustStrip`   — 3 короткие подписи через middle-dot
{%- endcomment -%}
<section
  class='section-container hero intro'
  aria-labelledby='hero-title'
>
  <div class='hero__scrim' aria-hidden='true'></div>

  <div class='container hero-content'>
    <div class='hero-header'>
      {% if meta.heroEyebrow %}
        <p class='hero__eyebrow'>
          <span class='hero__eyebrow-rule' aria-hidden='true'></span>
          <span class='hero__eyebrow-text'>{{ meta.heroEyebrow }}</span>
          <span class='hero__eyebrow-rule' aria-hidden='true'></span>
        </p>
      {% endif %}

      <h1 id='hero-title' class='hero__title'>
        <span class='hero__title-line'>Мечтали порыбачить и отдохнуть?</span>
        <span class='hero__title-line hero__title-line--accent'>
          Усадьба Серебряный Карась ждёт Вас
        </span>
      </h1>

      <p class='hero__story'>{{ meta.brandStory }}</p>

      {% if meta.heroCta.primary or meta.heroCta.secondary %}
        <div
          class='hero__cta cta-row'
          role='group'
          aria-label='Забронировать или посмотреть услуги'
        >
          {% if meta.heroCta.primary %}
            <a
              class='cta cta--primary hero__cta-primary'
              href='{{ meta.heroCta.primary.href }}'
              {% if meta.heroCta.primary.ariaLabel %}
              aria-label='{{ meta.heroCta.primary.ariaLabel }}'
              {% endif %}
            >{{ meta.heroCta.primary.label }}</a>
          {% endif %}
          {% if meta.heroCta.secondary %}
            <a
              class='cta cta--ghost hero__cta-secondary'
              href='{{ meta.heroCta.secondary.href }}'
              {% if meta.heroCta.secondary.ariaLabel %}
              aria-label='{{ meta.heroCta.secondary.ariaLabel }}'
              {% endif %}
            >{{ meta.heroCta.secondary.label }}</a>
          {% endif %}
        </div>
      {% endif %}

      {% if meta.heroTrustStrip.size > 0 %}
        <ul class='hero__trust' role='list'>
          {% for item in meta.heroTrustStrip %}
            <li class='hero__trust-item'>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>
