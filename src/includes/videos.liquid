<section class='primary-video-section container'>
    <div
        class="primary-video-wrapper"
        data-video-url="assets/videos/main-video-compressed"
        data-video-extensions="webm,mp4"
        data-video-poster="assets/images/video-poster.webp"
        style="
            overflow: hidden;
            padding-top: 56.25%;
            position: relative;
            width: 100%;
      "
    >
    </div>
    {% comment %} <video
        controls
        loop
        preload="auto"
        muted="false"
        poster="assets/images/video-poster.webp"
    >
        <source src="assets/videos/main-video-compressed.webm" type="video/webm">
        <source src="assets/videos/main-video-compressed.mp4" type="video/mp4">
        <div>Your browser does not support the video tag.</div>
    </video> {% endcomment %}
</section>
