{% comment %}
  Mobile drawer: .menu-scrim = dimmed overlay (tap/Escape closes — sideBar.js).
  Toggler: aria-expanded + aria-label updated in JS; icons aria-hidden (decorative).
{% endcomment %}
<header class='header'>
  <div
    class='menu-scrim'
    data-menu-scrim
    aria-hidden='true'
  ></div>
  <nav class='navbar' aria-label='Основная навигация'>
    <button
      aria-controls='navbar-collapse'
      aria-expanded='false'
      aria-label='Открыть меню'
      class='navbar-toggler'
      type='button'
    >
      <i data-lucide='menu' class='open-menu' aria-hidden='true'></i>
      <i data-lucide='x' class='close-menu hidden' aria-hidden='true'></i>
    </button>
    <div class='navbar-logo'>
      <a class='logo' href='#top' aria-label='На главную: Усадьба Серебряный Карась'>
        <span class='logo-item'>Усадьба&nbsp;</span>
        <span class='logo-item'>Серебряный&nbsp;</span>
        <span class='logo-item'>Карась</span>
      </a>
    </div>
    {% render 'menu' %}
  </nav>

  {% comment %} {% render 'components/contact-button.ejs' %} {% endcomment %}

  {% comment %} {% render 'components/modal' %} {% endcomment %}
</header>
