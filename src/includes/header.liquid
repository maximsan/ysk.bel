<!-- Navigation -->
<header class='header'>
    <nav class='navbar navbar-expand-md navbar-dark header bg-light-black'>
        <div class='container'>
            <button
                aria-controls='navbar-collapse'
                aria-expanded='false'
                aria-label='toggle navigation'
                class='navbar-toggler'
                type='button'
            >
                <img src='assets/images/icons/menu.svg' alt='open-menu' class='open-menu'>
                <img src='assets/images/icons/close.svg' alt='close-menu' class='close-menu hidden'>
            </button>
            <div class='navbar-header'>
                <h1 class='brand'>
                    <span class='brand-item'>Усадьба&nbsp;</span>
                    <span class='brand-item'>Серебряный&nbsp;</span>
                    <span class='brand-item'>Карась</span>
                </h1>
            </div>
            {% render 'sidebar' %}
        </div>
    </nav>

    <!-- <% render 'components/contact-button.ejs' %> -->

    {% render 'components/modal' %}
</header>
