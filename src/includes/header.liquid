<!-- Navigation -->
<header class='header'>
  <nav class='navbar'>
    <button
      aria-controls='navbar-collapse'
      aria-expanded='false'
      aria-label='toggle navigation'
      class='navbar-toggler'
      type='button'
    >
      <img
        src='assets/images/icons/menu.svg'
        alt='open-menu'
        class='open-menu'
        width='24'
        height='24'
        decoding='async'
      >
      <img
        src='assets/images/icons/close.svg'
        alt='close-menu'
        class='close-menu hidden'
        width='24'
        height='24'
        decoding='async'
      >
    </button>
    <div class='navbar-logo'>
      <h1 class='logo'>
        <span class='logo-item'>Усадьба&nbsp;</span>
        <span class='logo-item'>Серебряный&nbsp;</span>
        <span class='logo-item'>Карась</span>
      </h1>
    </div>
    {% render 'menu' %}
  </nav>

  {% comment %} {% render 'components/contact-button.ejs' %} {% endcomment %}

  {% comment %} {% render 'components/modal' %} {% endcomment %}
</header>
