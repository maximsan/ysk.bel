<!-- meta info -->
<meta charset='utf-8'>
<meta content='ie=edge' http-equiv='X-UA-Compatible'>
<meta
  content='width=device-width, initial-scale=1, shrink-to-fit=no'
  name='viewport'
>
<meta
  name='keywords'
  content='{{ meta.keywords }}'
>
<meta
  name='description'
  content='{{ meta.description }}'
>
<meta
  property='og:title'
  content='{{ meta.ogTitle }}'
>
<meta
  property='og:description'
  content='{{ meta.ogDescription }}'
>
<meta name='author' content='{{ meta.author }}'>

<!-- favicon -->
<link rel='apple-touch-icon' sizes='180x180' href='assets/icons/apple-touch-icon.png'>
<link rel='icon' type='image/png' sizes='32x32' href='assets/icons/favicon-32x32.png'>
<link rel='icon' type='image/png' sizes='16x16' href='assets/icons/favicon-16x16.png'>
<link rel='manifest' href='assets/icons/site.webmanifest'>

<meta
  name='theme-color'
  content='{{ themeColor | default: meta.themeColor | default: '#5f6f6d' }}'
>
<meta
  name='theme-color'
  content='{{ themeColorDark | default: meta.themeColorDark | default: '#1c2724' }}'
  media='(prefers-color-scheme: dark)'
>
<!-- To run web application in full-screen -->
<meta content='yes' name='apple-mobile-web-app-capable'>
<!-- Status Bar Style (see Supported Meta Tags below for available values) -->
<!-- Has no effect unless you have the previous meta tag -->
<meta content='black' name='apple-mobile-web-app-status-bar-style'>

<!-- Fonts: Rubik (400/500/700 + 500 italic) + Source Serif 4 (600) — single request, Cyrillic + Latin via font subsetting -->
<link rel='preconnect' href='https://fonts.googleapis.com'>
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
<link
  href='https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,400;0,500;0,700;1,500&family=Source+Serif+4:opsz,wght@8..60,600&display=swap'
  rel='stylesheet'
>

<!-- Hero LCP preload — AVIF with WebP/CSS fallback (`image-set`) in `_hero.scss`. Unsupported `type`s skip preload. -->
<link
  rel='preload'
  as='image'
  type='image/avif'
  href='assets/images/hero-fish-800.avif'
  imagesrcset='assets/images/hero-fish-600.avif 600w, assets/images/hero-fish-800.avif 800w, assets/images/hero-fish-1200.avif 1200w, assets/images/hero-fish-1600.avif 1600w'
  imagesizes='100vw'
  fetchpriority='high'
>

<!-- Document Title -->
<title>{{ meta.title }}</title>

<!-- Google Tag Manager -->
<script>
  function loadGoogleTagManager(w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  }

  window.addEventListener('load', function () {
    window.setTimeout(function () {
      loadGoogleTagManager(window, document, 'script', 'dataLayer', 'GTM-5W4KDDW');
    }, 4000);
  });
</script>
<!-- End Google Tag Manager -->

<!-- Yandex.Metrika counter -->
<script type='text/javascript'>
  function loadYandexMetrika(m, e, t, r, i, k, a) {
    m[i] =
      m[i] ||
      function () {
        (m[i].a = m[i].a || []).push(arguments);
      };
    m[i].l = 1 * new Date();
    (k = e.createElement(t)),
      (a = e.getElementsByTagName(t)[0]),
      (k.async = 1),
      (k.src = r),
      a.parentNode.insertBefore(k, a);
  }

  window.addEventListener('load', function () {
    window.setTimeout(function () {
      loadYandexMetrika(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
      ym(67016224, 'init', {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
        webvisor: true,
      });
    }, 4500);
  });
</script>
<noscript>
  <div>
    <img
      src='https://mc.yandex.ru/watch/67016224'
      style='position:absolute; left:-9999px;'
      width='1'
      height='1'
      alt=''
    >
  </div>
</noscript>
<!-- /Yandex.Metrika counter -->

<link rel='stylesheet' type='text/css' href='{{ 'styles/index.scss' | hashed }}'>
<link rel='stylesheet' type='text/css' href='{{ 'assets/bootstrap.css' | url }}'>
<link rel='stylesheet' type='text/css' href='{{ 'assets/main.css' | url }}'>
<link rel='stylesheet' type='text/css' href='{{ 'assets/photoswipe.css' | url }}'>

<script defer src='scripts/index.js'></script>
