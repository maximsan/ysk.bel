<div class='overlay'></div>
<div class='section-container info-banner'>
  <div class='cross'>
    <span class='cross-icon'>&times;</span>
  </div>
  <h3 class='info-banner__header'>{{ banner.intro }}</h3>
  {% for message in banner.messages %}
    <div class='info-banner__text'>{{ message }}</div>
  {% endfor %}
</div>
