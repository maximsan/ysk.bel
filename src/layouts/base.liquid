<!DOCTYPE html>
<html class="no-js" lang={{ meta.lang }}>
<head>
    {% include 'head.liquid' %}
</head>
<body>

<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5W4KDDW"
                  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<!--[if lte IE 9]>
<p class='browserupgrade'>
    You are using an <strong>outdated</strong> browser. Please
    <a href='https://browsehappy.com/'>upgrade your browser</a> to
    improve your experience and security.
</p>
<![endif]-->

<button class="scroll-up" id="scroll-up" title="Назад к меню">
    <i class="fas fa-arrow-up"></i>
</button>

{% include "header.liquid" %}

<main>

    {{ content }}

<!-- Banner with important info-->
    {% include 'components/info-banner.liquid' %}
<!-- Page Content -->
    {% include 'hero-section.liquid' %}
<!-- Services section -->
    {% include 'services.liquid' %}
<!-- Contacts section -->
    {% assign lat = '54.291652' %}
    {% assign lng = '27.480454' %}
    {% include 'contacts.liquid' %}
</main>

<!-- TODO: feedback section -->
<!-- Thank you page -->
<div id="thankyou_message" style="display:none;">
    <h2>Thanks for contacting us! We will get back to you soon!</h2>
</div>

<!--Footer navigation start-->
{% include 'footer.liquid' %}
<!--Footer navigation end-->

<!--Photo swipe start-->
{%- include 'components/photo-swipe.liquid' %}
<!--Photo swipe end-->


<script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
        dataLayer.push(arguments);
    }

    gtag('js', new Date());
    gtag('config', 'G-0MVEPHZ43W');
</script>


<!-- Google maps -->
<script
        async
        defer
        src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCEjXw1mbGTXw12jnM_YTAveRGb1I4c3gQ"
></script>
<!-- end Google Maps -->
</body>
</html>
