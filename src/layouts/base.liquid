<!doctype html>
<html class='no-js' lang='{{ meta.lang }}'>
  <head>
    {% comment %}
      Optional front matter: `themeColor` / `themeColorDark` per page (data cascade). Falls back to `meta`.
    {% endcomment %}
    {% assign pageThemeColor = themeColor | default: meta.themeColor %}
    {% assign pageThemeColorDark = themeColorDark | default: meta.themeColorDark %}
    {% render 'head', themeColor: pageThemeColor, themeColorDark: pageThemeColorDark %}
  </head>
  <body id='top'>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src='https://www.googletagmanager.com/ns.html?id=GTM-5W4KDDW'
        height='0'
        width='0'
        style='display:none;visibility:hidden'
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!--[if lte IE 9]>
      <p class='browserupgrade'>
          You are using an <strong>outdated</strong> browser. Please
          <a href='https://browsehappy.com/'>upgrade your browser</a> to
          improve your experience and security.
      </p>
    <![endif]-->

    {% render 'header' %}

    <main style='display: flex; flex-direction: column;'>
      {{ content }}

      <!-- Page Content -->
      {% render 'hero-section' %}
      <!-- Banner with important info -->
      {% render 'components/info-banner' %}
      <!-- Services section -->
      {% render 'services' %}
      <!-- Stocking with fish (carousel) -->
      {% render 'stocking-with-fish-carousel' %}
      <!-- Video section -->
      {% render 'videos' %}
      <!-- Contacts section -->
      {% render 'contacts' %}
    </main>

    <!-- TODO: feedback section -->
    <!-- Thank you page -->
    <div id='thankyou_message' style='display:none;'>
      <h2>Thanks for contacting us! We will get back to you soon!</h2>
    </div>

    {% render 'cooperation-banner' %}

    <!-- Footer navigation start -->
    {% render 'footer' %}
    <!-- Footer navigation end -->

    <script>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('js', new Date());
      gtag('config', 'G-0MVEPHZ43W');
    </script>

  </body>
</html>
