# Copy to `.env` and edit. `*.env` is gitignored.
##
# Eleventy loads this file automatically (see `eleventy.config.js` → `import 'dotenv/config'`).
# `deploy.sh` only exports the REMOTE_* / LOCAL_PATH variables below (see its `grep` line).
# Playwright reads CI / PLAYWRIGHT_PREBUILT_DIST from the environment; use `export`, direnv,
# or your shell’s equivalent — `.env` alone is not applied to `yarn test:*` unless you wire it.

# --- Maps JavaScript API (bundled into `dist/scripts/index.js` at build time) ---
# Public browser key. Restrict in Google Cloud: HTTP referrers for your domains; API: Maps JavaScript API only.
# Production CI sets REQUIRE_GOOGLE_MAPS_API_KEY=1 and fails deploy builds when this value is missing.
GOOGLE_MAPS_API_KEY=
REQUIRE_GOOGLE_MAPS_API_KEY=

# --- Deploy (`./deploy.sh` rsync) ---
REMOTE_USER=
REMOTE_HOST=
REMOTE_PATH=
# Local directory or path passed to rsync (e.g. `dist` — match CI secret if you deploy CI artifacts).
LOCAL_PATH=dist

# --- Playwright (optional overrides) ---
# Set automatically in GitHub Actions. Uncomment to mimic CI (retries, workers, `github` reporter).
# CI=true
# `1` = `webServer` serves existing `dist/` only (visual job / reuse build). See `playwright.config.js`.
# PLAYWRIGHT_PREBUILT_DIST=1

# --- Eleventy debug (optional) ---
# Verbose Eleventy logging; also available via `yarn debug` (sets DEBUG=* in the script).
# DEBUG=*

# --- GitGuardian ggshield (pre-commit) ---
# ggshield reads `GITGUARDIAN_API_KEY` from `.env` at the repo root (see GitGuardian docs).
# Personal access token: https://dashboard.gitguardian.com/api/personal-access-tokens
GITGUARDIAN_API_KEY=
