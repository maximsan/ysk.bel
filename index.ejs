            ga.l = +new Date();
            ga('create', 'UA-131113332-1', 'auto');
            ga('send', 'pageview');
        </script>
        <script
            async
            defer
            src="https://www.google-analytics.com/analytics.js"
        ></script>

        <!-- Google maps -->
        <script
                async
