{
  "name": "yck.surge.sh",
  "version": "3.0.0",
  "description": "Усадьба Серебряный Карась",
  "homepage": "www.уск.бел",
  "scripts": {
    "watch:eleventy": "eleventy --serve",
    "build:eleventy": "eleventy",
    "debug": "DEBUG=* eleventy --serve",
    "dev": "npm-run-all clean watch:eleventy",
    "build": "npm-run-all clean build:eleventy",
    "clean": "rm -rf dist",
    "format": "prettier --write src",
    "deploy:sh": "npx surge dist ysk.surge.sh",
    "deploy": "npm-run-all clean build:eleventy deploy:sh",
    "deploy:rb": "./deploy.sh",
    "deploy:all": "npm-run-all clean build:eleventy deploy:rb",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maximsan/ysk.bel"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "photoswipe": "^5.4.3",
    "popper.js": "1.16.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@playwright/test": "^1.52.0",
    "@shopify/prettier-plugin-liquid": "^1.5.0",
    "bootstrap": "4.5.3",
    "esbuild": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "sass": "1.69.5",
    "serve": "^14.2.4"
  },
  "author": "maximsan",
  "license": "MIT",
  "volta": {
    "node": "20.15.0",
    "yarn": "4.5.2"
  },
