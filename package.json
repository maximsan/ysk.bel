    "photoswipe": "4.1.3",
    "popper.js": "1.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "7.2.3",
    "@types/webpack": "5.28.1",
    "babel-loader": "8.0.5",
    "babel-plugin-syntax-dynamic-import": "6.18.0",
    "clean-webpack-plugin": "4.0.0",
    "cross-env": "5.2.0",
