{
  "name": "yck.surge.sh",
  "version": "3.0.0",
  "description": "Усадьба Серебряный Карась",
  "homepage": "www.уск.бел",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev webpack serve --mode development --config webpack.config.dev.js",
    "build": "npm run clean && webpack --progress --mode production --config webpack.config.prod.js",
    "deploy": "npm run clean && npm run build && npx surge dist ysk.surge.sh",
    "clean": "rm -rf dist",
    "format": "prettier --write src/styles src/js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maximsan/ysk.bel"
  },
  "dependencies": {
    "aos": "2.3.4",
    "bootstrap": "4.5.3",
    "dir-loader": "0.3.0",
    "ejs": "^3.1.9",
    "ejs-lint": "^2.0.0",
    "global": "^4.4.0",
    "jquery": "^3.6.4",
    "modernizr": "3.11.4",
    "photoswipe": "4.1.3",
    "popper.js": "1.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@babel/preset-env": "7.2.3",
    "@types/webpack": "5.28.1",
    "babel-loader": "8.0.5",
    "babel-plugin-syntax-dynamic-import": "6.18.0",
    "clean-webpack-plugin": "4.0.0",
    "cross-env": "5.2.0",
    "css-loader": "6.7.3",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.1",
    "prettier": "^2.8.8",
    "sass": "1.62.0",
    "sass-loader": "13.2.2",
    "style-loader": "3.3.2",
    "template-ejs-loader": "^0.9.4",
    "url-loader": "^4.1.1",
    "webpack": "5.80.0",
    "webpack-cli": "5.0.1",
    "webpack-dev-server": "4.13.3",
    "webpack-merge": "5.8.0"
  },
  "author": "maximsan",
  "license": "MIT",
  "volta": {
    "node": "18.16.0"
  },
  "packageManager": "yarn@3.5.0"
}
